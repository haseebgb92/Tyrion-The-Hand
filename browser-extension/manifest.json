{
  "manifest_version": 3,
  "name": "Tyrion \u2013 The Hand",
  "version": "1.2.0",
  "description": "Tyrion dispatch and a local per-conversation instruction queue; no ChatGPT output scraping.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:17877/*",
    "https://chatgpt.com/*",
    "http://127.0.0.1:17879/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tyrion \u2014 shared tasks",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "handoff.js"
      ],
      "run_at": "document_start"
    }
  ]
}